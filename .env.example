# Server-only MongoDB connection string. Never expose this as VITE_*.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/raldin_portfolio

# Server-only authentication secret (generate a long random value).
JWT_SECRET=replace-with-a-long-random-secret
# Server-only rotating salt used to group analytics visitors without exposing raw IPs in aggregates.
ANALYTICS_HASH_SALT=replace-with-another-long-random-secret

# Origin allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:5173

# Optional Vercel/runtime settings.
# Do NOT put NODE_ENV here. Vite loads this file into `process.env`, so a
# NODE_ENV=development in `.env` would make `vite build` emit Vue's development
# runtime (~52 kB larger, with dev warnings in the browser console). Leave it
# unset locally: the API already treats "not production" as development, and
# `vite build` then defaults to production. To force it for one build, use
# `NODE_ENV=production npm run build`.
PORT=3000

# Optional one-time admin bootstrap values; do not use after provisioning.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
