# Server-only MongoDB connection string. Never expose this as VITE_*.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/raldin_portfolio

# Server-only authentication secret (generate a long random value).
JWT_SECRET=replace-with-a-long-random-secret

# Origin allowed to call the API from a browser.
FRONTEND_ORIGIN=http://localhost:5173

# Optional Vercel/runtime settings.
NODE_ENV=development
PORT=3000

# Optional one-time admin bootstrap values; do not use after provisioning.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-me
